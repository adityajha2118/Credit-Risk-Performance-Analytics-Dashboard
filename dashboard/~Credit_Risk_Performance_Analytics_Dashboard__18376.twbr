      <aliases enabled='yes' />
      <column caption='Default Rate' datatype='real' default-format='p0.00%' name='[Calculation_1262817705246722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_status]) / COUNT([loan_status])' />
      </column>
      <column caption='Avg Default Probability' datatype='real' default-format='p0.00%' name='[Calculation_1262817705480195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([default_probability])' />
      </column>
      <column caption='Total Applicants' datatype='integer' name='[Calculation_1262817705689092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([loan_status])' />
      </column>
      <column caption='High Risk Count' datatype='integer' name='[Calculation_1262817705775109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [risk_segment] = &quot;High Risk&quot; THEN 1 ELSE 0 END)' />
      </column>
